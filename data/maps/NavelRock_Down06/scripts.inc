NavelRock_Down06_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, NavelRock_Down06_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, NavelRock_Down06_OnResume
	.byte 0

NavelRock_Down06_OnTransition:
	call_if_set FLAG_CAUGHT_NAVEL_ROCK_MOLTRES_GALAR, NavelRock_Down06_EventScript_HideLegendary
	call_if_unset FLAG_CAUGHT_NAVEL_ROCK_MOLTRES_GALAR, NavelRock_Down06_EventScript_TryShowLegendary
	end

NavelRock_Down06_EventScript_HideLegendary::
	setflag FLAG_HIDE_NAVEL_ROCK_MOLTRES_GALAR
	return

NavelRock_Down06_EventScript_TryShowLegendary::
	goto_if_set FLAG_DEFEATED_NAVEL_ROCK_MOLTRES_GALAR, Common_EventScript_NopReturn
	clearflag FLAG_HIDE_NAVEL_ROCK_MOLTRES_GALAR
	return

NavelRock_Down06_OnResume:
	call_if_set FLAG_SYS_CTRL_OBJ_DELETE, NavelRock_Down06_EventScript_TryRemoveLegendary
	end

NavelRock_Down06_EventScript_TryRemoveLegendary::
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_ne VAR_RESULT, B_OUTCOME_CAUGHT, Common_EventScript_NopReturn
	removeobject LOCALID_NAVEL_ROCK_MOLTRES_GALAR
	return

NavelRock_Down06_EventScript_Legendary::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_NAVEL_ROCK_6, CRY_MODE_ENCOUNTER
	delay 40
	waitmoncry
	seteventmon SPECIES_NAVEL_ROCK_6, POSTGAME_LEVEL
	setflag FLAG_SYS_CTRL_OBJ_DELETE
	special BattleSetup_StartLegendaryBattle
	clearflag FLAG_SYS_CTRL_OBJ_DELETE
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_eq VAR_RESULT, B_OUTCOME_WON, NavelRock_Down06_EventScript_DefeatedLegendary
	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, NavelRock_Down06_EventScript_RanFromLegendary
	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, NavelRock_Down06_EventScript_RanFromLegendary
	setflag FLAG_CAUGHT_NAVEL_ROCK_MOLTRES_GALAR
	release
	end

NavelRock_Down06_EventScript_DefeatedLegendary::
	setflag FLAG_DEFEATED_NAVEL_ROCK_MOLTRES_GALAR
	setvar VAR_0x8004, SPECIES_NAVEL_ROCK_BOTTOM
	goto Common_EventScript_LegendaryFlewAway
	end

NavelRock_Down06_EventScript_RanFromLegendary::
	setvar VAR_0x8004, SPECIES_NAVEL_ROCK_BOTTOM
	goto Common_EventScript_LegendaryFlewAway
	end
